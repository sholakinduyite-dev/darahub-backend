# Dara's Hub backend: environment variables
# Copy to .env for local use. On the host (Render/Railway) add these in the "Environment" settings page.
# NEVER commit real values to GitHub and never paste them into chat.

# Database (the host gives you this when you create a PostgreSQL database)
DATABASE_URL=

# Sign-in tokens: use long random strings (at least 32 characters), different for each
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Paystack (Dashboard > Settings > API Keys). The same secret key signs webhook calls.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# PocketFi (names depend on PocketFi's documentation; fill in once you have their API docs)
POCKETFI_API_KEY=
POCKETFI_WEBHOOK_SECRET=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials). One client ID per platform.
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# Firebase Cloud Messaging for push notifications (Firebase Console > Project settings > Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email and SMS provider for verification codes (choose providers, then add their keys)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# Image storage for product photos, receipts and review photos
STORAGE_CLOUD_NAME=
STORAGE_API_KEY=
STORAGE_API_SECRET=

# App
NODE_ENV=development
PORT=3000
APP_BASE_URL=
# The first owner account, created once when the database is set up
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
