# Dara's Hub backend: environment variables
# Copy to .env for local use. On the host (Render, Replit and so on) add these in its "Environment" / "Secrets" settings.
# NEVER commit real values to GitHub and never paste them into chat.

# ---- Needed to start (everything else can wait) ----
# PostgreSQL connection string. A free database from Neon, Supabase or Render gives you one.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Long random strings (at least 32 characters), different from each other. Make them with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Testing helpers (turn OFF before real customers use the app) ----
# console = print one-time email codes in the server log instead of sending real email. live = send them (needs an email provider, see src/lib/messenger.ts)
MESSAGING_MODE=console
# true = also return the code in the API response so you can test without email
DEV_SHOW_CODES=false

# ---- First owner account and demo data (used by: npm run db:seed) ----
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
# true = add one demo product per category so the app has something to show
SEED_DEMO=false

# ---- Google sign-in (Google Cloud Console > APIs & Services > Credentials). One client ID per platform you ship. ----
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# ---- Paystack (Dashboard > Settings > API Keys). Used when the payments module is added. ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=

# ---- PocketFi (names depend on PocketFi's documentation) ----
POCKETFI_API_KEY=
POCKETFI_WEBHOOK_SECRET=
POCKETFI_BUSINESS_ID=
POCKETFI_CHECKOUT_URL=
POCKETFI_CALLBACK_URL=

# ---- Firebase Cloud Messaging for push notifications (Firebase Console > Project settings > Service accounts) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Email provider for real verification codes ----
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# ---- Image storage for product photos, receipts and review photos ----
STORAGE_CLOUD_NAME=
STORAGE_API_KEY=
STORAGE_API_SECRET=

# ---- App ----
NODE_ENV=development
PORT=3000
# Websites allowed to call the API (the admin website later). Comma separated. The phone app does not need this.
CORS_ORIGINS=
